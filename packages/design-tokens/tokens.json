    "brandArabic": {
      "family": "ZEYADA Arabic 1",
      "appFamily": "ZeyadaArabic",
      "weights": [
        400,
        500,
        700
      ],
      "licence": "commercial — add licensed files to packages/brand/fonts",
      "fallback": [
        "Amiri",
        "Tajawal"
      ]
    },
    "brandLatin": {
      "family": "Canela Text",
      "appFamily": "CanelaText",
      "weights": [
        400,
        500,
        700
      ],
      "licence": "commercial (Commercial Type) — add licensed files to packages/brand/fonts",
      "fallback": [
        "Amiri",
        "Georgia",
        "serif"
      ]
    },
    "ui": "Tajawal",
    "numbers": "Jost",
    "quran": "Amiri Quran",
    "naskh": "Amiri",
