NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://yaqeen:yaqeen@localhost:5432/yaqeen
REDIS_URL=redis://localhost:6379

# Long random strings (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_JWT_SECRET=change-me-to-a-different-long-random-string-32
# Seals admin TOTP secrets at rest (AES-256-GCM). Required in production: openssl rand -base64 32
ADMIN_SECRETS_KEY=

# Comma-separated origins allowed to call the API from a browser (admin dashboard)
CORS_ORIGINS=http://localhost:3000

# Sign in with Google / Apple (audience = your OAuth client IDs, comma-separated)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.yaqinbrand.yaqeen

# Shopify Admin API (custom app with write_discounts scope)
SHOPIFY_SHOP_DOMAIN=yaqin-brand.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Signing secret of the shop's orders/paid webhook → <api>/webhooks/shopify/orders-paid (marks codes used)
SHOPIFY_WEBHOOK_SECRET=

# Firebase service account JSON (single line) for FCM
FIREBASE_SERVICE_ACCOUNT_JSON=

# Hijri calendar
ALADHAN_BASE_URL=https://api.aladhan.com/v1
HIJRI_REGION=EG

# Public profile cards («بطاقة يقين», NFC/QR): the host serving /u/<handle> — point a vanity domain
# (e.g. id.yaqin-brand.com) at the API and set it here; the store and app-store links of its CTA.
PUBLIC_PROFILE_BASE_URL=https://api.yaqin-brand.com
STORE_URL=https://www.yaqin-brand.com
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.yaqinbrand.yaqeen
# Empty until the App Store listing exists (iPhone visitors then go to the store site).
APP_STORE_URL=

# Capacity / resilience (see docs/OPERATIONS.md)
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=300
MAX_EVENT_LOOP_DELAY_MS=1000
SHUTDOWN_GRACE_MS=10000

# Tafsir pack on Cloudflare R2 (the "Tafsir pack" workflow prints these; docs/CONTENT_PACKS.md) — registered by `pnpm db:seed` when set.
TAFSIR_PACK_URL=
TAFSIR_PACK_SHA256=
TAFSIR_PACK_SIZE=
TAFSIR_PACK_VERSION=1
TAFSIR_SOURCE_VERSION=

# Observability (docs/OPERATIONS.md › Observability) — all optional, empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
GIT_SHA=dev
METRICS_PORT=0
# Product analytics forwarding (consented events only) — PostHog EU project key.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
