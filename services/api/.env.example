NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://yaqeen:yaqeen@localhost:5432/yaqeen
REDIS_URL=redis://localhost:6379

# Long random strings (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_JWT_SECRET=change-me-to-a-different-long-random-string-32

# Comma-separated origins allowed to call the API from a browser (admin dashboard)
CORS_ORIGINS=http://localhost:3000

# Sign in with Google / Apple (audience = your OAuth client IDs, comma-separated)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.yaqinbrand.yaqeen

# Shopify Admin API (custom app with write_discounts scope)
SHOPIFY_SHOP_DOMAIN=yaqin-brand.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Firebase service account JSON (single line) for FCM
FIREBASE_SERVICE_ACCOUNT_JSON=

# Hijri calendar
ALADHAN_BASE_URL=https://api.aladhan.com/v1
HIJRI_REGION=EG

# Capacity / resilience (see docs/OPERATIONS.md)
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=300
MAX_EVENT_LOOP_DELAY_MS=1000
SHUTDOWN_GRACE_MS=10000
