// Copy to Secrets.xcconfig (git-ignored) or let CI write it. Values come from the Google Cloud
// OAuth iOS client of the Yaqeen project.
GOOGLE_IOS_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

// Meta App Events (optional). Leave empty to ship without Meta; set together with the same values
// passed as --dart-define FACEBOOK_APP_ID / FACEBOOK_CLIENT_TOKEN (docs/RELEASE_MOBILE.md).
FACEBOOK_APP_ID =
FACEBOOK_CLIENT_TOKEN =
