<?xml version="1.0" encoding="utf-8"?>
<!-- Worship data (hifz, azkar, reading) stays on this device: no cloud backup or device transfer
     until the encrypted backup of spec §6.13 exists. Tokens live in the Keystore anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
